# Name of the existing Docker network shared by Caddy + shared-postgres
#   find it with:  docker inspect shared-postgres -f '{{json .NetworkSettings.Networks}}'
SHARED_WEB=shared-web
SHARED_DB=shared-db

# URL prefix (app is served at https://apps.tinyserverlab.in/pibench/)
BASE_PATH=/pibench

# Dedicated database on the shared PostgreSQL (created by db/init.sql)
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=pibench_db
DB_USER=pibench_db_user
DB_PASSWORD=change-me

# Token the runner uses to upload results (generate: openssl rand -hex 24)
INGEST_TOKEN=change-me
