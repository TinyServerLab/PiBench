# Copy to pibench.env (same folder as pibench-run.sh) and edit.
# This file is sourced by the runner.

# Dashboard ingest (must match INGEST_TOKEN in the app's .env)
PIBENCH_URL="http://127.0.0.1:8095/pibench"
PIBENCH_TOKEN="change-me"

# Shared PostgreSQL container used for the pgbench test.
# The runner creates a throwaway database "pibench_pgbench_db" and drops it afterwards.
# No other database is touched.
PIBENCH_PG_CONTAINER="shared-postgres"
PIBENCH_PG_ADMIN_USER="postgres"
# PIBENCH_PG_ADMIN_PASSWORD=""   # only if local socket auth needs a password

# Optional: measure response time of your own apps (space separated).
# Prefer local URLs through Caddy so Cloudflare/internet latency doesn't dominate.
# PIBENCH_URLS="https://apps.tinyserverlab.in/inventory/ https://apps.tinyserverlab.in/finance/"

# Optional (causes brief downtime!): time a restart of these containers.
# PIBENCH_RESTART_CONTAINERS="inventory finance-tracker"

# Tuning (defaults shown)
# PIBENCH_ITERATIONS=3
# PIBENCH_FIO_RUNTIME=20
# PIBENCH_FIO_SIZE=1G
# PIBENCH_PGBENCH_TIME=30
# PIBENCH_SKIP=""                # e.g. "pgbench,urls"
